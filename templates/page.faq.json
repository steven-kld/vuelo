        },
        "collapsible_row_MEfnwT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Existe un monto mínimo de compra?",
            "icon": "question_mark",
            "row_content": "<p>Sí. El monto mínimo de compra es de <strong>$28.000 CLP</strong>. Esto nos permite mantener la calidad de nuestro servicio, preparar cada pedido con cuidado y garantizar que las flores lleguen frescas y en las mejores condiciones.</p>",
            "page": ""
          }
