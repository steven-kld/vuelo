 fwdD = `M ${bogX} ${bogY} Q ${midX} ${bogY - ARC_H} ${sclX} ${sclY}`;\n\n    dashF.setAttribute('d', fwdD);\n    maskF.setAttribute('d', fwdD);\n\n    lenF = dashF.getTotalLength();\n\n    [bogInner, bogOuter].forEach(el => { el.setAttribute('cx', bogX); el.setAttribute('cy', bogY); });\n    [sclInner, sclOuter].forEach(el => { el.setAttribute('cx', sclX); el.setAttribute('cy', sclY); });\n\n    const ly1 = bogY + 20, ly2 = bogY + 33;\n    lblBog.setAttribute('x', bogX); lblBog.setAttribute('y', ly1);\n    subBog.setAttribute('x', bogX); subBog.setAttribute('y', ly2);\n    lblScl.setAttribute('x', sclX); lblScl.setAttribute('y', ly1);\n    subScl.setAttribute('x', sclX); subScl.setAttribute('y', ly2);\n\n    maskF.style.strokeDasharray = lenF + ' 99999';\n    maskF.style.strokeDashoffset = 0;\n    ready = true;\n  }\n\n  function setMask(mask, len, traveled) {\n    const remaining = Math.max(0, len - traveled);\n    mask.style.strokeDasharray = remaining + ' 99999';\n    mask.style.strokeDashoffset = -traveled;\n  }\n\n  function easeInOut(t) {\n    return t < 0.5 ? 2*t*t : -1+(4-2*t)*t;\n  }\n\n  function fwdPath() {\n    return `M ${bogX} ${bogY} Q ${W/2} ${bogY - ARC_H} ${sclX} ${sclY}`;\n  }\n\n  let start = null;\n  function tick(ts) {\n    if (!ready) { requestAnimationFrame(tick); return; }\n    if (!start) start = ts;\n    const f = ((ts - start) % CYCLE) / CYCLE;\n\n    plane.style.opacity = 0;\n    dashF.style.opacity = 0;\n    maskF.style.opacity = 0;\n\n    if (f >= FWD_START && f < 1) {\n      const active = f < FWD_END;\n      const t = active ? (f - FWD_START) / (FWD_END - FWD_START) : 1;\n      const p = easeInOut(Math.min(t, 1));\n      const traveled = p * lenF;\n\n      let op = 1;\n      if (active && t < FADE) op = t / FADE;\n      else if (!active) op = Math.max(0, 1 - (f - FWD_END) / (1 - FWD_END));\n\n      setMask(maskF, lenF, traveled);\n      maskF.style.opacity = 1;\n      dashF.style.opacity = op;\n      plane.style.opacity = op;\n     