{% comment %}
  Прогресс к минимальному заказу (28.000 CLP).

  Accepts:
  - mode: {String} 'product' | 'cart'
  - product: {Object} товар (mode: 'product')
  - limit: {Number} лимит количества варианта, null — без лимита (mode: 'product')
  - stock_limited: {Boolean} лимит задан остатком склада (mode: 'product')
  - cart_qty: {Number} количество варианта в корзине (mode: 'product')

  Usage:
  {% render 'min-order-progress', mode: 'product', product: product, limit: qty_max, stock_limited: qty_stock_limited, cart_qty: cart_qty %}
  {% render 'min-order-progress', mode: 'cart' %}
{% endcomment %}

{%- liquid
  # 28.000 CLP в сотых, как все суммы Shopify
  assign min_order_threshold = 2800000
-%}

{%- if mode == 'product' -%}
  {%- assign mop_variant = product.selected_or_first_available_variant -%}
  <min-order-progress class="min-order-progress">
    <div class="min-order-progress__status" hidden>
      <p class="min-order-progress__text" aria-live="polite"></p>
      <div class="min-order-progress__bar" aria-hidden="true">
        <span class="min-order-progress__fill"></span>
      </div>
    </div>
    <script type="application/json" data-min-order-data>
      {
        "productId": {{ product.id | json }},
        "variantId": {{ mop_variant.id | json }},
        "available": {{ mop_variant.available | default: false | json }},
        "price": {{ mop_variant.price | json }},
        "limit": {{ limit | json }},
        "stockLimited": {{ stock_limited | default: false | json }},
        "cartQty": {{ cart_qty | default: 0 | json }},
        "cartTotal": {{ cart.total_price | json }},
        "threshold": {{ min_order_threshold | json }},
        "thresholdFormatted": {{ min_order_threshold | money | strip_html | json }},
        "moneyFormat": {{ shop.money_format | json }},
        "texts": {
          "stockOnly": {{ 'Solo hay {N} disponibles.' | json }},
          "stockWithCart": {{ 'Solo hay {N} disponibles y ya tienes {K} en el carrito.' | json }},
          "stockAllInCart": {{ 'Ya tienes en el carrito las {N} disponibles.' | json }},
          "reached": {{ 'Tu pedido ya alcanza el mínimo.' | json }},
          "selectionCompletes": {{ 'Con esta selección completas tu pedido — agrégala al carrito.' | json }},
          "oneMore": {{ 'Con 1 más de esta flor completas tu pedido.' | json }},
          "twoMore": {{ 'Con 2 más de esta flor completas tu pedido.' | json }},
          "minimum": {{ 'Pedido mínimo {T} en total. Combina las flores que quieras.' | json }},
          "missing": {{ 'Con esta selección te faltan {Y} — combina con otras flores.' | json }}
        }
      }
    </script>
  </min-order-progress>

  {%- assign mop_shipping_url = pages['valores-de-despacho-por-comunas-en-santiago'].url -%}
  {%- if mop_shipping_url != blank -%}
    <p class="min-order-progress__shipping caption">
      Despacho según tu comuna — <a href="{{ mop_shipping_url }}" class="link">ver tarifas</a>
    </p>
  {%- endif -%}
{%- elsif mode == 'cart' and cart.item_count > 0 -%}
  {%- liquid
    # Без JS: cart.js перерисовывает .js-contents футера корзины при каждом изменении
    assign mop_missing = min_order_threshold | minus: cart.total_price
    assign mop_percent = cart.total_price | times: 100 | divided_by: min_order_threshold | at_most: 100
  -%}
  <div class="min-order-progress min-order-progress--cart">
    <p class="min-order-progress__text">
      {%- if mop_missing > 0 -%}
        Te faltan {{ mop_missing | money }} para completar tu pedido.
      {%- else -%}
        Tu pedido ya alcanza el mínimo.
      {%- endif -%}
    </p>
    <div class="min-order-progress__bar" aria-hidden="true">
      <span class="min-order-progress__fill" style="width: {{ mop_percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
