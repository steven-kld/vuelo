{% comment %}
  Прогресс к минимальному заказу (28.000 CLP).

  Accepts:
  - mode: {String} 'product' | 'cart'
  - product: {Object} товар (mode: 'product')
  - limit: {Number} лимит количества варианта, null — без лимита (mode: 'product')
  - stock_limited: {Boolean} лимит задан остатком склада (mode: 'product')
  - cart_qty: {Number} количество варианта в корзине (mode: 'product')

  Usage:
  {% render 'min-order-progress', mode: 'product', product: product, limit: qty_max, stock_limited: qty_stock_limited, cart_qty: cart_qty %}
  {% render 'min-order-progress', mode: 'cart' %}
{% endcomment %}

{%- liquid
  # 28.000 CLP в сотых, как все суммы Shopify
  assign min_order_threshold = 2800000
-%}

{%- if mode == 'product' -%}
  {%- liquid
    assign mop_variant = product.selected_or_first_available_variant

    assign mop_text_reached = 'Tu pedido ya alcanza el mínimo.'
    assign mop_text_selection_completes = 'Con esta selección completas tu pedido — agrégala al carrito.'
    assign mop_text_minimum = 'Pedido mínimo {T} en total. Combina las flores que quieras.'
    assign mop_text_missing = 'Con esta selección te faltan {Y} — combina con otras flores.'
    assign mop_text_stock_only = 'Solo hay {N} disponibles.'
    assign mop_text_stock_with_cart = 'Solo hay {N} disponibles y ya tienes {K} en el carrito.'
    assign mop_text_stock_all_in_cart = 'Ya tienes en el carrito las {N} disponibles.'
    assign mop_text_one_more = 'Con 1 más de esta flor completas tu pedido.'
    assign mop_text_two_more = 'Con 2 más de esta flor completas tu pedido.'
    # Тексты с {N} {K} {T} {Y} — только через assign: «}» внутри {{ }} ломает парсер Shopify

    # Начальное состояние на сервере (без сдвига вёрстки); якорь 1–2 шт. и остаток уточняет JS
    assign mop_qty = mop_variant.quantity_rule.min | default: 1
    assign mop_projected = mop_variant.price | default: 0 | times: mop_qty | plus: cart.total_price
    assign mop_missing = min_order_threshold | minus: mop_projected
    assign mop_percent = mop_projected | times: 100 | divided_by: min_order_threshold | at_most: 100
    assign mop_threshold_formatted = min_order_threshold | money | strip_html

    if cart.total_price >= min_order_threshold
      assign mop_text = mop_text_reached
    elsif mop_missing <= 0
      assign mop_text = mop_text_selection_completes
    elsif cart.total_price == 0
      assign mop_text = mop_text_minimum | replace: '{T}', mop_threshold_formatted
    else
      assign mop_missing_formatted = mop_missing | money | strip_html
      assign mop_text = mop_text_missing | replace: '{Y}', mop_missing_formatted
    endif
  -%}
  <min-order-progress class="min-order-progress{% unless mop_variant.available %} min-order-progress--unavailable{% endunless %}">
    <div class="min-order-progress__status">
      <p class="min-order-progress__text" aria-live="polite">{{ mop_text }}</p>
      <div class="min-order-progress__bar" aria-hidden="true">
        <span class="min-order-progress__fill" style="width: {{ mop_percent }}%;"></span>
      </div>
    </div>
    <script type="application/json" data-min-order-data>
      {
        "productId": {{ product.id | json }},
        "variantId": {{ mop_variant.id | json }},
        "available": {{ mop_variant.available | default: false | json }},
        "price": {{ mop_variant.price | json }},
        "limit": {{ limit | json }},
        "stockLimited": {{ stock_limited | default: false | json }},
        "cartQty": {{ cart_qty | default: 0 | json }},
        "cartTotal": {{ cart.total_price | json }},
        "threshold": {{ min_order_threshold | json }},
        "thresholdFormatted": {{ mop_threshold_formatted | json }},
        "moneyFormat": {{ shop.money_format | json }},
        "texts": {
          "stockOnly": {{ mop_text_stock_only | json }},
          "stockWithCart": {{ mop_text_stock_with_cart | json }},
          "stockAllInCart": {{ mop_text_stock_all_in_cart | json }},
          "reached": {{ mop_text_reached | json }},
          "selectionCompletes": {{ mop_text_selection_completes | json }},
          "oneMore": {{ mop_text_one_more | json }},
          "twoMore": {{ mop_text_two_more | json }},
          "minimum": {{ mop_text_minimum | json }},
          "missing": {{ mop_text_missing | json }}
        }
      }
    </script>
  </min-order-progress>

  {%- assign mop_shipping_url = pages['valores-de-despacho-por-comunas-en-santiago'].url -%}
  {%- if mop_shipping_url != blank -%}
    <p class="min-order-progress__shipping caption">
      Despacho según tu comuna — <a href="{{ mop_shipping_url }}" class="link">ver tarifas</a>
    </p>
  {%- endif -%}
{%- elsif mode == 'cart' and cart.item_count > 0 -%}
  {%- liquid
    # Без JS: cart.js перерисовывает .js-contents футера корзины при каждом изменении
    assign mop_missing = min_order_threshold | minus: cart.total_price
    assign mop_percent = cart.total_price | times: 100 | divided_by: min_order_threshold | at_most: 100
  -%}
  <div class="min-order-progress min-order-progress--cart">
    <p class="min-order-progress__text">
      {%- if mop_missing > 0 -%}
        Te faltan {{ mop_missing | money }} para completar tu pedido.
      {%- else -%}
        Tu pedido ya alcanza el mínimo.
      {%- endif -%}
    </p>
    <div class="min-order-progress__bar" aria-hidden="true">
      <span class="min-order-progress__fill" style="width: {{ mop_percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
